# MongoDB Configuration
# Uncomment and set one of the following options:

# Option 1: MongoDB Atlas (Cloud Database) - Recommended
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your-database

# Option 2: Local MongoDB (if you have MongoDB running locally)
# MONGODB_URI=mongodb://localhost:27017/rednote-ai-agent

# Option 3: Leave empty to run without database
# MONGODB_URI=

# Other environment variables can be added here as needed
